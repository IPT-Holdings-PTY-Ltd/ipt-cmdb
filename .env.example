# Store production secrets in Azure Key Vault and map them to these environment variables.
PORT=3000
DATA_DIR=/app/data
# Use easy_auth behind Azure Container Apps authentication; keep local for development.
AUTH_MODE=local
# Trusted externally reachable origin used to build password-reset links. Use
# HTTPS outside localhost and never derive this value from an inbound Host header.
PUBLIC_BASE_URL=http://localhost:3000
# Azure Easy Auth paths and headers are runtime-configurable so the same image
# can run behind Container Apps, App Service, or an equivalent trusted gateway.
ENTRA_LOGIN_URL=/.auth/login/aad?post_login_redirect_uri=/
ENTRA_LOGOUT_URL=/.auth/logout?post_logout_redirect_uri=/#/login
ENTRA_PRINCIPAL_HEADER=x-ms-client-principal
ENTRA_PRINCIPAL_NAME_HEADER=x-ms-client-principal-name
ENTRA_EMAIL_CLAIMS=preferred_username,http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress,emails
# Leave false with Easy Auth. Enable only for an explicitly controlled break-glass account.
ALLOW_LOCAL_BREAK_GLASS=false
# TOTP applies only to local/break-glass accounts. Supply a stable, URL-safe
# base64-encoded 32-byte key through Key Vault or the container secret store.
MFA_ENCRYPTION_KEY=
# Alternative for Docker/Kubernetes secret mounts. The file must contain only the key.
MFA_ENCRYPTION_KEY_FILE=
# The same installation key encrypts write-only Microsoft Graph client secrets.
# For certificate authentication, mount the PFX/PEM read-only into the container.
EMAIL_CERTIFICATE_PATH=
EMAIL_CERTIFICATE_PASSWORD=
EMAIL_CERTIFICATE_PASSWORD_FILE=
# Durable notifications are manual by default. Enable only after Microsoft 365
# delivery, contact ownership, fallback recipients, and templates are reviewed.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
# optional, admins, or all
LOCAL_MFA_POLICY=optional
# Production persistence. The browser never sees this value.
# DATABASE_URL=postgresql://cmdb:cmdb@localhost:5432/cmdb
# Leave blank only for first-start database setup. Canonical CMDB operations require PostgreSQL.
DATABASE_URL=
# Alternative for Docker/Kubernetes secret mounts. The file must contain only the PostgreSQL URL.
DATABASE_URL_FILE=
# Required only when the first-start UI persists database settings. Keep this separate from
# MFA_ENCRYPTION_KEY and supply one stable URL-safe base64-encoded 32-byte key or a key file.
DATABASE_CONFIG_ENCRYPTION_KEY=
DATABASE_CONFIG_ENCRYPTION_KEY_FILE=
# Applied only when the connected database has no CMDB operational state.
# Use "empty" for a new production workspace, "demo" locally, or "current" when migrating JSON state.
DATABASE_SEED_MODE=empty
# Used only when a blank database receives its first platform administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Azure can map this from Key Vault; secret-file mounts should use the _FILE variant.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD_FILE=
# Leave false in production. Environment/Key Vault database settings remain read-only in the app.
ALLOW_UI_DATABASE_CONFIG=false
# Opt-in escape hatch for lightweight development without PostgreSQL. Never use in production.
ALLOW_LOCAL_DEVELOPMENT=false
# ConnectWise Manage REST API (use regional API base URL, not the UI URL)
CW_BASE_URL=https://api-<region>.myconnectwise.net/v4_6_release/apis/3.0
CW_COMPANY_ID=your-cw-company-id
CW_PUBLIC_KEY=your-public-key
CW_PRIVATE_KEY=your-private-key
CW_CLIENT_ID=your-client-id
# Future provider adapter configuration
NCENTRAL_BASE_URL=https://your-ncentral.example/api
NCENTRAL_API_TOKEN=
PASSPORTAL_BASE_URL=https://your-passportal-api.example
PASSPORTAL_API_TOKEN=
