# Production secrets belong in Azure Key Vault or another server-side secret manager.
PORT=3000
DATA_DIR=/app/data
DATABASE_URL=postgresql://cmdb:cmdb@localhost:5432/cmdb

# ConnectWise Manage (read-only API member recommended initially)
CW_BASE_URL=https://api-<region>.myconnectwise.net/v4_6_release/apis/3.0
CW_COMPANY_ID=your-cw-company-id
CW_PUBLIC_KEY=your-public-key
CW_PRIVATE_KEY=your-private-key
CW_CLIENT_ID=your-client-id

# Future provider connectors
NCENTRAL_BASE_URL=https://your-ncentral.example/api
NCENTRAL_API_TOKEN=
PASSPORTAL_BASE_URL=https://your-passportal-api.example
PASSPORTAL_API_TOKEN=
