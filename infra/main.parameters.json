{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "postgresAdministratorPassword": {
      "value": "${CMDB_POSTGRES_ADMIN_PASSWORD}"
    },
    "mfaEncryptionKey": {
      "value": "${CMDB_MFA_ENCRYPTION_KEY}"
    },
    "bootstrapAdminEmail": {
      "value": "${CMDB_BOOTSTRAP_ADMIN_EMAIL}"
    },
    "bootstrapAdminPassword": {
      "value": "${CMDB_BOOTSTRAP_ADMIN_PASSWORD}"
    },
    "enableEntraAuth": {
      "value": true
    },
    "entraClientId": {
      "value": "${CMDB_ENTRA_CLIENT_ID}"
    },
    "entraClientSecret": {
      "value": "${CMDB_ENTRA_CLIENT_SECRET}"
    }
  }
}
