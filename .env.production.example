# Copy to a protected file outside the repository where practical. This file
# contains deployment settings only; secret values live in the referenced files.
CMDB_IMAGE=ghcr.io/ipt-holdings-pty-ltd/ipt-cmdb:v0.3.0
CMDB_BIND_ADDRESS=127.0.0.1
CMDB_PORT=3000
PUBLIC_BASE_URL=https://cmdb.example.com
CMDB_CPU_LIMIT=1.0
CMDB_MEMORY_LIMIT=1g
# Bound upgrade waits so orchestration can fail closed instead of hanging indefinitely.
CMDB_MIGRATION_LOCK_TIMEOUT_MS=60000
CMDB_MIGRATION_STATEMENT_TIMEOUT_MS=900000

# Use absolute paths. On Linux, keep the parent directory 0700 and make the
# individually mounted secret files read-only 0444 after writing them.
DATABASE_URL_SECRET_FILE=C:/cmdb-secrets/database-url.txt
MFA_ENCRYPTION_KEY_SECRET_FILE=C:/cmdb-secrets/mfa-encryption-key.txt
EMAIL_CERTIFICATE_PATH=
EMAIL_CERTIFICATE_PASSWORD_SECRET_FILE=
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_INTERVAL_SECONDS=60
INTEGRATION_WORKER_ENABLED=false
INTEGRATION_WORKER_INTERVAL_SECONDS=2
INTEGRATION_ALERT_RECIPIENTS=
CMDB_WORKER_CPU_LIMIT=0.5
CMDB_WORKER_MEMORY_LIMIT=512m
BOOTSTRAP_ADMIN_PASSWORD_SECRET_FILE=C:/cmdb-secrets/bootstrap-admin-password.txt
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Production requires a trusted identity-aware proxy that strips inbound identity
# headers and injects verified Microsoft-compatible principal headers.
AUTH_MODE=easy_auth
LOG_FORMAT=json
LOG_LEVEL=INFO
# Exact immediate proxy IPs/CIDRs only. Leave blank until the reverse-proxy
# network is known; never use * or 0.0.0.0/0.
FORWARDED_ALLOW_IPS=
LOCAL_LOGIN_IDENTIFIER_LIMIT=5
LOCAL_LOGIN_IDENTIFIER_WINDOW_SECONDS=900
LOCAL_LOGIN_SOURCE_LIMIT=20
LOCAL_LOGIN_SOURCE_WINDOW_SECONDS=900
LOCAL_LOGIN_PENDING_TTL_SECONDS=120
LOCAL_LOGIN_THROTTLE_AUDIT_SECONDS=300
ENTRA_LOGIN_URL=/.auth/login/aad?post_login_redirect_uri=/
ENTRA_LOGOUT_URL=/.auth/logout?post_logout_redirect_uri=/#/login
ENTRA_PRINCIPAL_HEADER=x-ms-client-principal
ENTRA_PRINCIPAL_NAME_HEADER=x-ms-client-principal-name
LOCAL_MFA_POLICY=admins
ALLOW_LOCAL_BREAK_GLASS=false

# Optional root ConnectWise PSA connection. Leave all blank to configure the
# same fields in Administration > Integrations, encrypted by MFA_ENCRYPTION_KEY.
# When any CW_ value is supplied, all required values must be supplied and the
# connection becomes read-only in the UI.
CW_BASE_URL=
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=
CW_PAGE_SIZE=100

# Optional root N-central connection. Leave direct token values blank here when
# injecting them from a secret store. Prefer NCENTRAL_USER_API_TOKEN_FILE with a
# read-only file mounted at the same container path in both web and worker services.
NCENTRAL_BASE_URL=
NCENTRAL_USER_API_TOKEN=
NCENTRAL_USER_API_TOKEN_FILE=
# Compatibility alias only; new deployments should use NCENTRAL_USER_API_TOKEN.
NCENTRAL_API_TOKEN=
NCENTRAL_PAGE_SIZE=250
NCENTRAL_GRAPHQL_ENABLED=false
NCENTRAL_GRAPHQL_ENDPOINT=https://api.n-able.com/graphql
NCENTRAL_GRAPHQL_API_TOKEN=
NCENTRAL_GRAPHQL_API_TOKEN_FILE=
NCENTRAL_GRAPHQL_PAGE_SIZE=100
NCENTRAL_GRAPHQL_SERVER_ID=
