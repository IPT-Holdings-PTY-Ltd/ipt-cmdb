{
  "name": "ipt-cmdb",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "npm run test:node && npm run test:frontend",
    "test:node": "node --test test/server.test.js",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "lint": "oxlint --disable-unicorn-plugin --react-plugin --jsx-a11y-plugin --vitest-plugin -D correctness -D suspicious -A react/react-in-jsx-scope --deny-warnings frontend/src frontend/test",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@xyflow/react": "^12.8.0",
    "elkjs": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
